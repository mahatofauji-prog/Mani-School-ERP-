rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'founder_admin';
    }
    function isSchoolAdmin(schoolId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && (user.role == 'founder_admin' || (user.role == 'school_admin' && user.schoolId == schoolId));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSchoolAdmin(resource.data.schoolId));
      allow create: if isAdmin() || (isSignedIn() && isSchoolAdmin(request.resource.data.schoolId));
      allow update, delete: if isAdmin() || (isSignedIn() && isSchoolAdmin(resource.data.schoolId));
    }
    
    match /schools/{schoolId} {
      allow read: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId);
      allow create, update, delete: if isAdmin();
    }
  }
}
